# ─── Core ────────────────────────────────────────────────────────────────
# Canonical public origin, no trailing slash. REQUIRES BUSINESS INPUT (domain).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001

# Must stay "false" everywhere except the real production deployment.
# When false: robots.txt disallows all and every page is noindex.
SITE_INDEXABLE=false

# ─── Database / CMS ──────────────────────────────────────────────────────
# Local dev uses the embedded Postgres started by `npm run dev:db`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/joblink
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# ─── Public media storage (production) ───────────────────────────────────
# Leave empty in development (files are stored on local disk in ./media).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Feature gates (see src/config/features.ts) ──────────────────────────
# Overseas recruitment additionally requires a verified MGLSD external
# licence number in src/config/business.ts. Do not enable without it.
FEATURE_OVERSEAS_RECRUITMENT=false
# Candidate applications / CV storage. Requires confirmed PDPO registration.
FEATURE_CANDIDATE_SYSTEM=false
# Employer recruitment-request form (Phase 3).
FEATURE_EMPLOYER_ENQUIRIES=false

# ─── Spam protection (optional; Cloudflare Turnstile) ────────────────────
# When both are set, public forms require a Turnstile check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
